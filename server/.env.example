# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Preferred: discrete DB credentials (avoids URL-encoding issues with special characters
# in passwords). Set all four, or none.
DB_HOST=localhost
DB_PORT=3306
DB_USER=pof_user
DB_PASSWORD=change-me
DB_NAME=highlight_pof

# Alternative: a single connection string (only used if DB_HOST/DB_USER/DB_NAME are unset).
# Any special characters in the password must be percent-encoded.
# DATABASE_URL=mysql://pof_user:change-me@localhost:3306/highlight_pof

JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
